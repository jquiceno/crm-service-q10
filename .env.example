# Copy to .env and fill in the values. .env is gitignored; this file is not, so it must never
# contain a real key.
#
#   Copy-Item .env.example .env
#
# Multitenancy is required and there is no in-memory fallback, so the service does not boot without
# a reachable tenant resolver, the encryption passphrase and Redis.

# Tenant resolver, with a trailing slash -- the tenant code is appended to it.
TENANT_RESOLVER_SERVICE_URL=http://localhost:8443/tenants/

# Environment discriminator sent as ?clientEnv=. The resolver uses it to decide which connection
# string to hand back; "local" is the one a developer machine can actually reach. Leave empty in
# deployed environments so no query parameter is sent at all.
TenantResolverService__ClientEnv=local

# Passphrase for the AES-256-CBC connection string the resolver returns. SECRET -- ask the tech lead.
# In deployed environments this arrives from the platform-shared secret, never from a file.
CONNSTRING_ENCRYPTION_KEY=

# Mandatory L2 cache. `docker compose up -d redis` gives you one on this address.
Cache__L2Enabled=true
Cache__ConnectionString=localhost:6379
