# -----------------------------------------------------------------------------
# RUNTIME & ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Standard .NET Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=

# The port where the application will listen inside the container
# Build-time: docker build --build-arg APP_PORT=9090 .
# Runtime override: docker run -e ASPNETCORE_URLS=http://+:9090 ...
ASPNETCORE_URLS=http://+:8080

# -----------------------------------------------------------------------------
# APPLICATION METADATA
# -----------------------------------------------------------------------------
ServiceInfo__Name=
ServiceInfo__Version=

# -----------------------------------------------------------------------------
# MONITORING & TELEMETRY
# -----------------------------------------------------------------------------
# Azure Application Insights Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Sentry Error Tracking & Performance Monitoring
Sentry__Enabled=true
Sentry__Dsn=
Sentry__TracesSampleRate=0.3
# Minimum log levels for the Sentry sink (Serilog LogEventLevel, bound by name — case-insensitive).
# Valid values: Verbose | Debug | Information | Warning | Error | Fatal
# MinimumEventLevel      -> minimum level sent to Sentry as an event  (default: Error)
# MinimumBreadcrumbLevel -> minimum level captured as a breadcrumb    (default: Warning)
Sentry__MinimumEventLevel=Error
Sentry__MinimumBreadcrumbLevel=Warning
Sentry__DeniedHeaders=Authorization,Proxy-Authorization,Cookie,Set-Cookie,X-Api-Key,X-Forwarded-For,X-Real-Ip,X-Csrf-Token,X-Xsrf-Token

# -----------------------------------------------------------------------------
# MULTITENANCY / TENANT RESOLVER (Fail-Fast enabled)
# -----------------------------------------------------------------------------
# There is no database connection string here: with multitenancy on, the
# tenant-resolver returns it encrypted per request, keyed by the request's
# EntityCode, and it is decrypted with CONNSTRING_ENCRYPTION_KEY.
#
# Toggle multitenancy (true/false). When false the service boots on an
# in-memory database and none of the variables below are required.
TenantResolverService__Enabled=false

# All four below are REQUIRED when TenantResolverService__Enabled=true —
# startup aborts with an explicit error if any is missing. Commented out to match
# the toggle above; uncomment them together with it, or Cache__* alone will make
# every boot pay a Redis connect timeout for a cache nothing is using.
#
# Platform-wide shared secrets. These two use the platform's language-agnostic
# names (no __ nesting) so every service consumes the same variable.
#TENANT_RESOLVER_SERVICE_URL=
#CONNSTRING_ENCRYPTION_KEY=

# The L2 cache is mandatory under multitenancy: without it the resolver would be
# called over HTTP on every single request.
#Cache__L2Enabled=true
#Cache__ConnectionString=localhost:6379

# Optional, shown with their defaults
TenantResolverService__TimeoutSeconds=15
TenantResolverService__CacheTtlMinutes=10

# -----------------------------------------------------------------------------
# AZURE KEY VAULT CONFIGURATION
# -----------------------------------------------------------------------------
# Toggle Azure Key Vault usage (true/false)
AzureKeyVault__Enabled=
AzureKeyVault__Endpoint=

# Authentication credentials for local/service principal access
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AWS CONFIGURATION (S3 / OpenSearch / Bedrock)
# -----------------------------------------------------------------------------
AWS__Region=
AWS__AccessKey=
AWS__SecretKey=

# Specific AWS Resources
AWS__S3__BucketName=
AWS__OpenSearch__Endpoint=

# Health check endpoints for load balancer probes:
#   Liveness:  GET /health/live     (ASP.NET built-in health checks)
#   Readiness: GET /health/ready    (ASP.NET built-in health checks)
#   App info:  GET /info            (custom controller, returns service metadata)
#
# Last updated: 2026-07-27
