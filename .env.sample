# -----------------------------------------------------------------------------
# RUNTIME & ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Standard .NET Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=

# Environment name Jack
Stackify__Environment=

# The port where the application will listen inside the container
# Build-time: docker build --build-arg APP_PORT=9090 .
# Runtime override: docker run -e ASPNETCORE_URLS=http://+:9090 ...
ASPNETCORE_URLS=http://+:8080

# -----------------------------------------------------------------------------
# APPLICATION METADATA
# -----------------------------------------------------------------------------
AppInfo__ServiceName=
AppInfo__Version=

# -----------------------------------------------------------------------------
# MONITORING & TELEMETRY
# -----------------------------------------------------------------------------
# Azure Application Insights Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# PERSISTENCE / DATABASE (Fail-Fast enabled)
# -----------------------------------------------------------------------------
# Toggle database connectivity (true/false)
Persistence__Enabled=true

# Database Connection String
# For Docker/Linux environments, use the double underscore __ for nesting
Persistence__ConnectionString=Server=my_server;Database=my_db;User Id=my_user;Password=my_password;TrustServerCertificate=True;

# -----------------------------------------------------------------------------
# AZURE KEY VAULT CONFIGURATION
# -----------------------------------------------------------------------------
# Toggle Azure Key Vault usage (true/false)
AzureKeyVault__Enabled=
AzureKeyVault__Endpoint=

# Authentication credentials for local/service principal access
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AWS CONFIGURATION (S3 / OpenSearch / Bedrock)
# -----------------------------------------------------------------------------
AWS__Region=
AWS__AccessKey=
AWS__SecretKey=

# Specific AWS Resources
AWS__S3__BucketName=
AWS__OpenSearch__Endpoint=

# Health check endpoints for load balancer probes:
#   Liveness:  GET /health          (ASP.NET built-in health checks)
#   App info:  GET /api/v1/health   (custom controller, returns service metadata)
#
# Last updated: 2026-03-26