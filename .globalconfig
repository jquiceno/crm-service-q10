# ═══════════════════════════════════════════════════════════════════════════════
# SDK CA Rules — none (intentionally suppressed)
# ═══════════════════════════════════════════════════════════════════════════════

# Irrelevant for internal services
dotnet_diagnostic.CA1014.severity = none

# DDD uses marker interfaces (IAggregateRoot)
dotnet_diagnostic.CA1040.severity = none

# DDD bounded context types match namespace segments by design
dotnet_diagnostic.CA1724.severity = none

# DDD uses nested types inside value objects
dotnet_diagnostic.CA1034.severity = none

# Too aggressive for a template (would seal all public types)
dotnet_diagnostic.CA1515.severity = none

# Error record name is an intentional domain concept despite matching a VB keyword
dotnet_diagnostic.CA1716.severity = none

# DomainException uses primary constructor; standard triple-constructor pattern not required
dotnet_diagnostic.CA1032.severity = none

# Exception serialization not relevant in .NET Core services
dotnet_diagnostic.CA2237.severity = none

# LoggerMessage source generation is opt-in; direct ILogger calls are acceptable
dotnet_diagnostic.CA1848.severity = none

# Startup/diagnostic Console.WriteLine messages do not need resource tables
dotnet_diagnostic.CA1303.severity = none

# Log level strings are intentionally lowercase; ToUpperInvariant would break the format
dotnet_diagnostic.CA1308.severity = none

# Serilog APIs do not expose IFormatProvider overloads in all cases
dotnet_diagnostic.CA1305.severity = none

# Created(string, object) is acceptable; Uri overload adds no value for empty-location responses
dotnet_diagnostic.CA2234.severity = none

# Result<T> uses static factory methods (Success/Failure) on a generic type — intentional API
dotnet_diagnostic.CA1000.severity = none

# Roslynator version of CA1032 — DomainException primary constructor is sufficient
dotnet_diagnostic.RCS1194.severity = none

