                ]
              }
            }
          ]
        },
        {
          "name": "POST con name de 51 caracteres → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Entity-Code", "value": "{{entityCode}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"isActive\": true\n}"
