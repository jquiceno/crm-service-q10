                "type": "text/javascript",
                "exec": ["pm.test('400 y no crea nada', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "PUT sin isActive → 400",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Entity-Code", "value": "{{entityCode}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Solo el nombre\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/loss-reasons/{{readOnlyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["loss-reasons", "{{readOnlyId}}"]
