{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Sentry": {
    "Enabled": false,
    "Dsn": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Cache": {
    "Enabled": true,
    "L2Enabled": false,
    "DefaultTtlSeconds": 300,
    "ConnectionString": ""
  },
  "TenantResolverService": {
    "Enabled": false,
    "BaseUrl": "",
    "TimeoutSeconds": 15,
    "CacheTtlMinutes": 10,
    "EncryptionKey": "",
    "ClientEnv": ""
  }
}
