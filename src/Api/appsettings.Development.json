{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Sentry": {
    "Enabled": false,
    "Dsn": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Cache": {
    "Enabled": true,
    "L2Enabled": true,
    "DefaultTtlSeconds": 300,
    "ConnectionString": "localhost:6379"
  },
  "TenantResolverService": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8443/tenants/",
    "ClientEnv": "local",
    "TimeoutSeconds": 15,
    "CacheTtlMinutes": 10,
    "EncryptionKey": ""
  }
}
