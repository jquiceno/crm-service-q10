{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "Persistence": {
        "Enabled": false,
        "ConnectionString": ""
    },
    "Sentry": {
        "Enabled": false,
        "Dsn": ""
    },
    "Cors": {
        "AllowedOrigins": ["http://localhost:3000"]
    },
    "Cache": {
        "Enabled": true,
        "DefaultTtlSeconds": 300,
        "ConnectionString": ""
    }
}
