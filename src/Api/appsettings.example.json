{
    "ServiceInfo": {
        "Name": "ServiceTemplate",
        "Version": "1.0.0"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "Persistence": {
        "Enabled": false,
        "ConnectionString": ""
    },
    "Cache": {
        "Enabled": true,
        "L2Enabled": false,
        "DefaultTtlSeconds": 300,
        "ConnectionString": ""
    }
}
