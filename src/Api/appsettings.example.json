{
    "RoutePrefix": "/crm-service",
    "ServiceInfo": {
        "Name": "CrmService",
        "Version": "1.0.0"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "Sentry": {
        "Enabled": false,
        "Dsn": "",
        "TracesSampleRate": 0.2,
        "MinimumEventLevel": "Error",
        "MinimumBreadcrumbLevel": "Warning",
        "DeniedHeaders": "Authorization,Proxy-Authorization,Cookie,Set-Cookie,X-Api-Key,X-Forwarded-For,X-Real-Ip,X-Csrf-Token,X-Xsrf-Token"
    },
    "Cache": {
        "Enabled": true,
        "L2Enabled": true,
        "DefaultTtlSeconds": 300,
        "ConnectionString": ""
    },
    "TenantResolverService": {
        "Enabled": true,
        "BaseUrl": "",
        "TimeoutSeconds": 15,
        "CacheTtlMinutes": 10,
        "EncryptionKey": ""
    }
}
