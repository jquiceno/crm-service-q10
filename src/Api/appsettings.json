{
  "AppInfo": {
    "ServiceName": "ServiceTemplate",
    "Version": "1.0.0"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "Cache": {
    "Enabled": false,
    "ConnectionString": "",
    "DefaultTtlSeconds": 300,
    "KeyPrefix": "api:v1"
  }
}